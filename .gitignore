# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# The binary `go build` drops in the repo root
/stocko2

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Log files
*.log

# Editor/IDE
# .idea/
# .vscode/

*.json

# Scratch notes holding credentials
yuh.txt

# Scanner output and collected dataset
data/

CLAUDE.md
key2
key2.pub 
